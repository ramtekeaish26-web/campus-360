generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String     @id @default(uuid())
  code        String     @unique // STUDENT, FACULTY, ADMIN
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  userRoles   UserRole[]

  @@map("roles")
}

model User {
  id                        String                   @id @default(uuid())
  email                     String                   @unique
  isActive                  Boolean                  @default(true) @map("is_active")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  profile                   UserProfile?
  userRoles                 UserRole[]
  facultyOfferings          CourseOffering[]         @relation("FacultyOfferings")
  studentEnrollments        Enrollment[]             @relation("StudentEnrollments")
  facultyAttendanceSessions AttendanceSession[]      @relation("FacultyAttendanceSessions")
  studentAttendanceRecords  AttendanceRecord[]       @relation("StudentAttendanceRecords")
  facultyAssignments        Assignment[]             @relation("FacultyAssignments")
  studentSubmissions        AssignmentSubmission[]   @relation("StudentSubmissions")
  studentExamResults        ExamResult[]             @relation("StudentExamResults")
  authoredNotices           Notice[]                 @relation("AuthoredNotices")
  noticeReads               NoticeRead[]
  organizedEvents           Event[]                  @relation("OrganizedEvents")
  eventRegistrations        EventRegistration[]
  createdClubs              Club[]                   @relation("CreatedClubs")
  clubMemberships           ClubMembership[]
  requestedServices         ServiceRequest[]         @relation("RequestedServices")
  assignedServices          ServiceRequest[]         @relation("AssignedServices")
  serviceRequestComments    ServiceRequestComment[]
  serviceRequestHistories   ServiceRequestHistory[]
  reportedLostFoundItems    LostFoundItem[]
  lostFoundClaims           LostFoundClaim[]         @relation("ClaimantLostFound")
  moderatedClaims           LostFoundClaim[]         @relation("ModeratedClaims")
  feedbacks                 Feedback[]
  notifications             Notification[]
  conversations             Conversation[]
  pendingAiActions          AIPendingAction[]
  authoredKnowledgeDocs     KnowledgeDocument[]
  aiAuditLogs               AIAuditLog[]

  @@map("users")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Department {
  id              String           @id @default(uuid())
  code            String           @unique // CSE, MECH, etc.
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  programs        Program[]
  profiles        UserProfile[]
  subjects        Subject[]
  notices         Notice[]
  clubs           Club[]
  serviceRequests ServiceRequest[]

  @@map("departments")
}

model Program {
  id            String        @id @default(uuid())
  code          String        @unique // BTECH_CSE, BTECH_MECH
  name          String
  degree        String        // B.Tech, M.Tech, etc.
  durationYears Int           @default(4) @map("duration_years")
  departmentId  String        @map("department_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  profiles      UserProfile[]
  subjects      Subject[]

  @@map("programs")
}

model UserProfile {
  id           String      @id @default(uuid())
  userId       String      @unique @map("user_id")
  firstName    String      @map("first_name")
  lastName     String      @map("last_name")
  prn          String?     @unique // Permanent Registration Number for students / Emp ID for faculty
  phone        String?
  bio          String?
  avatarUrl    String?     @map("avatar_url")
  semester     Int?
  year         Int?
  rollNo       String?     @map("roll_no")
  departmentId String?     @map("department_id")
  programId    String?     @map("program_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  program      Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@map("profiles")
}

// ==========================================
// PHASE 2: ACADEMIC CORE MODELS
// ==========================================

model AcademicTerm {
  id             String                  @id @default(uuid())
  name           String                  // "2025-26 Semester 5 (Autumn)"
  academicYear   String                  @map("academic_year") // "2025-26"
  semester       Int                     @default(1)
  startDate      DateTime                @map("start_date")
  endDate        DateTime                @map("end_date")
  status         String                  @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  offerings      CourseOffering[]
  calendarEvents AcademicCalendarEvent[]

  @@map("academic_terms")
}

model Subject {
  id           String           @id @default(uuid())
  code         String           @unique // "CS301", "CS302", etc.
  name         String           // "Database Management Systems"
  description  String?
  credits      Int              @default(4)
  departmentId String           @map("department_id")
  programId    String?          @map("program_id")
  semester     Int              @default(1)
  status       String           @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program      Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  offerings    CourseOffering[]

  @@map("subjects")
}

model CourseOffering {
  id                 String              @id @default(uuid())
  subjectId          String              @map("subject_id")
  academicTermId     String              @map("academic_term_id")
  sectionName        String              @default("A") @map("section_name")
  facultyId          String?             @map("faculty_id")
  status             String              @default("ACTIVE") // ACTIVE, CANCELLED, COMPLETED
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicTerm       AcademicTerm        @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  faculty            User?               @relation("FacultyOfferings", fields: [facultyId], references: [id], onDelete: SetNull)
  enrollments        Enrollment[]
  schedules          ClassSchedule[]
  attendanceSessions AttendanceSession[]
  assignments        Assignment[]
  exams              Exam[]
  results            ExamResult[]

  @@unique([subjectId, academicTermId, sectionName])
  @@map("course_offerings")
}

model Enrollment {
  id               String         @id @default(uuid())
  studentId        String         @map("student_id")
  courseOfferingId String         @map("course_offering_id")
  enrolledAt       DateTime       @default(now()) @map("enrolled_at")
  status           String         @default("ACTIVE") // ACTIVE, DROPPED, COMPLETED
  student          User           @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseOfferingId])
  @@map("enrollments")
}

model ClassSchedule {
  id               String         @id @default(uuid())
  courseOfferingId String         @map("course_offering_id")
  dayOfWeek        String         @map("day_of_week") // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY
  startTime        String         @map("start_time") // "09:00"
  endTime          String         @map("end_time") // "10:00"
  room             String         // "Room 302", "Lab 4"
  building         String         @default("Academic Block A")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@map("class_schedules")
}

model AttendanceSession {
  id               String             @id @default(uuid())
  courseOfferingId String             @map("course_offering_id")
  facultyId        String             @map("faculty_id")
  date             DateTime
  startTime        String             @map("start_time")
  endTime          String             @map("end_time")
  topic            String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  courseOffering   CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  faculty          User               @relation("FacultyAttendanceSessions", fields: [facultyId], references: [id], onDelete: Restrict)
  records          AttendanceRecord[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String            @map("session_id")
  studentId String            @map("student_id")
  status    String            @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  remarks   String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User              @relation("StudentAttendanceRecords", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

model Assignment {
  id               String                 @id @default(uuid())
  courseOfferingId String                 @map("course_offering_id")
  facultyId        String                 @map("faculty_id")
  title            String
  description      String
  dueDate          DateTime               @map("due_date")
  maxMarks         Float                  @default(100) @map("max_marks")
  status           String                 @default("ACTIVE") // DRAFT, ACTIVE, CLOSED
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  courseOffering   CourseOffering         @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  faculty          User                   @relation("FacultyAssignments", fields: [facultyId], references: [id], onDelete: Restrict)
  submissions      AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String     @map("assignment_id")
  studentId    String     @map("student_id")
  content      String     // Text response
  submittedAt  DateTime   @default(now()) @map("submitted_at")
  marks        Float?
  feedback     String?
  status       String     @default("SUBMITTED") // SUBMITTED, GRADED, RESUBMIT_REQUESTED
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Exam {
  id               String         @id @default(uuid())
  courseOfferingId String         @map("course_offering_id")
  title            String
  examType         String         @map("exam_type") // MIDTERM, END_SEMESTER, PRACTICAL, QUIZ
  date             DateTime
  startTime        String         @map("start_time")
  endTime          String         @map("end_time")
  room             String
  maxMarks         Float          @default(100) @map("max_marks")
  status           String         @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  results          ExamResult[]

  @@map("exams")
}

model ExamResult {
  id               String         @id @default(uuid())
  examId           String         @map("exam_id")
  studentId        String         @map("student_id")
  courseOfferingId String         @map("course_offering_id")
  marksObtained    Float          @map("marks_obtained")
  grade            String         // A+, A, B+, B, C, P, F
  remarks          String?
  status           String         @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  exam             Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student          User           @relation("StudentExamResults", fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@map("exam_results")
}

model AcademicCalendarEvent {
  id             String        @id @default(uuid())
  academicTermId String?       @map("academic_term_id")
  title          String
  description    String?
  eventType      String        @map("event_type") // ACADEMIC, EXAM, HOLIDAY, DEADLINE, OTHER
  startDate      DateTime      @map("start_date")
  endDate        DateTime      @map("end_date")
  visibility     String        @default("ALL") // ALL, STUDENT, FACULTY
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  @@map("academic_calendar_events")
}

// ==========================================
// PHASE 3: CAMPUS SPATIAL CORE & WAYFINDING
// ==========================================

model Campus {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  description String?
  address     String
  latitude    Float
  longitude   Float
  boundary    Json?
  status      String        @default("ACTIVE")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  buildings   Building[]
  places      CampusPlace[]
  paths       CampusPath[]

  @@map("campuses")
}

model Building {
  id              String             @id @default(uuid())
  campusId        String             @map("campus_id")
  name            String
  code            String             @unique
  description     String?
  buildingType    String             @default("ACADEMIC") @map("building_type")
  latitude        Float
  longitude       Float
  geometry        Json?
  status          String             @default("ACTIVE")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  campus          Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  floors          Floor[]
  entrances       Entrance[]
  places          CampusPlace[]
  images          LocationImage[]
  facilities      BuildingFacility[]
  serviceRequests ServiceRequest[]

  @@map("buildings")
}

model Floor {
  id           String      @id @default(uuid())
  buildingId   String      @map("building_id")
  name         String
  floorNumber  Int         @map("floor_number")
  displayOrder Int         @default(0) @map("display_order")
  floorPlan    String?     @map("floor_plan")
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  building     Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms        Room[]

  @@unique([buildingId, floorNumber])
  @@map("floors")
}

model Room {
  id              String           @id @default(uuid())
  floorId         String           @map("floor_id")
  roomNumber      String           @map("room_number")
  name            String
  roomType        String           @default("CLASSROOM") @map("room_type")
  description     String?
  capacity        Int?
  departmentId    String?          @map("department_id")
  latitude        Float?
  longitude       Float?
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  floor           Floor            @relation(fields: [floorId], references: [id], onDelete: Cascade)
  places          CampusPlace[]
  serviceRequests ServiceRequest[]

  @@unique([floorId, roomNumber])
  @@map("rooms")
}

model LocationCategory {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  icon         String?
  displayOrder Int           @default(0) @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  places       CampusPlace[]

  @@map("location_categories")
}

model Facility {
  id                 String             @id @default(uuid())
  code               String             @unique
  name               String
  description        String?
  icon               String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  placeFacilities    PlaceFacility[]
  buildingFacilities BuildingFacility[]

  @@map("facilities")
}

model CampusPlace {
  id                String             @id @default(uuid())
  campusId          String             @map("campus_id")
  name              String
  slug              String             @unique
  description       String?
  categoryId        String             @map("category_id")
  buildingId        String?            @map("building_id")
  roomId            String?            @map("room_id")
  latitude          Float
  longitude         Float
  geometry          Json?
  phone             String?
  email             String?
  website           String?
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  campus            Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  category          LocationCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  building          Building?          @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  images            LocationImage[]
  facilities        PlaceFacility[]
  events            Event[]
  serviceRequests   ServiceRequest[]
  lostFoundItems    LostFoundItem[]
  emergencyContacts EmergencyContact[]

  @@map("campus_places")
}

model PlaceFacility {
  id         String      @id @default(uuid())
  placeId    String      @map("place_id")
  facilityId String      @map("facility_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  place      CampusPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([placeId, facilityId])
  @@map("place_facilities")
}

model BuildingFacility {
  id         String   @id @default(uuid())
  buildingId String   @map("building_id")
  facilityId String   @map("facility_id")
  createdAt  DateTime @default(now()) @map("created_at")
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([buildingId, facilityId])
  @@map("building_facilities")
}

model Entrance {
  id                  String   @id @default(uuid())
  buildingId          String   @map("building_id")
  name                String
  latitude            Float
  longitude           Float
  type                String   @default("MAIN")
  accessibilityStatus Boolean  @default(true) @map("accessibility_status")
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  building            Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("entrances")
}

model CampusPath {
  id           String   @id @default(uuid())
  campusId     String   @map("campus_id")
  name         String
  geometry     Json
  pathType     String   @default("WALKWAY") @map("path_type")
  accessible   Boolean  @default(true)
  surface      String?
  lengthMeters Float    @default(0) @map("length_meters")
  startNode    String?  @map("start_node")
  endNode      String?  @map("end_node")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  campus       Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@map("campus_paths")
}

model LocationImage {
  id         String       @id @default(uuid())
  placeId    String?      @map("place_id")
  buildingId String?      @map("building_id")
  url        String
  altText    String       @map("alt_text")
  caption    String?
  sortOrder  Int          @default(0) @map("sort_order")
  status     String       @default("ACTIVE")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  place      CampusPlace? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  building   Building?    @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("location_images")
}

// ==========================================
// PHASE 4: CAMPUS SERVICES & ENGAGEMENT
// ==========================================

model Notice {
  id           String       @id @default(uuid())
  title        String
  summary      String?
  content      String
  category     String       @default("GENERAL") // ACADEMIC, EXAM, ADMINISTRATIVE, DEPARTMENT, GENERAL, EMERGENCY
  priority     String       @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  publishedAt  DateTime     @default(now()) @map("published_at")
  expiresAt    DateTime?    @map("expires_at")
  authorId     String       @map("author_id")
  departmentId String?      @map("department_id")
  status       String       @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  audience     String       @default("ALL") // ALL, STUDENT, FACULTY, ADMIN
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  author       User         @relation("AuthoredNotices", fields: [authorId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reads        NoticeRead[]

  @@map("notices")
}

model NoticeRead {
  id       String   @id @default(uuid())
  noticeId String   @map("notice_id")
  userId   String   @map("user_id")
  readAt   DateTime @default(now()) @map("read_at")
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@map("notice_reads")
}

model Event {
  id                   String              @id @default(uuid())
  title                String
  description          String
  category             String              @default("OTHER") // ACADEMIC, CULTURAL, SPORTS, TECHNICAL, WORKSHOP, SEMINAR, CLUB, OTHER
  startDateTime        DateTime            @map("start_date_time")
  endDateTime          DateTime            @map("end_date_time")
  locationId           String?             @map("location_id")
  venue                String?
  organizerId          String              @map("organizer_id")
  capacity             Int?
  registrationRequired Boolean             @default(false) @map("registration_required")
  status               String              @default("PUBLISHED") // DRAFT, PUBLISHED, CANCELLED, COMPLETED
  image                String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  organizer            User                @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Restrict)
  location             CampusPlace?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  registrations        EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  userId       String   @map("user_id")
  registeredAt DateTime @default(now()) @map("registered_at")
  status       String   @default("REGISTERED") // REGISTERED, CANCELLED, ATTENDED
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model Club {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  description  String
  category     String           @default("TECHNICAL") // TECHNICAL, CULTURAL, SPORTS, ACADEMIC, SOCIAL, OTHER
  departmentId String?          @map("department_id")
  logo         String?
  status       String           @default("ACTIVE") // ACTIVE, INACTIVE
  createdBy    String           @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  creator      User             @relation("CreatedClubs", fields: [createdBy], references: [id], onDelete: Restrict)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  memberships  ClubMembership[]

  @@map("clubs")
}

model ClubMembership {
  id       String   @id @default(uuid())
  clubId   String   @map("club_id")
  userId   String   @map("user_id")
  role     String   @default("MEMBER") // MEMBER, LEAD, ADMIN
  joinedAt DateTime @default(now()) @map("joined_at")
  status   String   @default("ACTIVE") // ACTIVE, PENDING, LEFT
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("club_memberships")
}

model ServiceCategory {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  icon         String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("service_categories")
}

model ServiceRequest {
  id                   String                  @id @default(uuid())
  requesterId          String                  @map("requester_id")
  title                String
  description          String
  category             String // ELECTRICAL, PROJECTOR, WIFI, CLEANLINESS, WATER, FURNITURE, INFRASTRUCTURE, GENERAL
  priority             String                  @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status               String                  @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED, REJECTED
  locationId           String?                 @map("location_id")
  buildingId           String?                 @map("building_id")
  roomId               String?                 @map("room_id")
  locationDetails      String?                 @map("location_details")
  assignedDepartmentId String?                 @map("assigned_department_id")
  assignedTo           String?                 @map("assigned_to")
  resolvedAt           DateTime?               @map("resolved_at")
  closedAt             DateTime?               @map("closed_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  requester            User                    @relation("RequestedServices", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedUser         User?                   @relation("AssignedServices", fields: [assignedTo], references: [id], onDelete: SetNull)
  assignedDepartment   Department?             @relation(fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  place                CampusPlace?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  building             Building?               @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  room                 Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  comments             ServiceRequestComment[]
  history              ServiceRequestHistory[]

  @@map("service_requests")
}

model ServiceRequestComment {
  id         String         @id @default(uuid())
  requestId  String         @map("request_id")
  authorId   String         @map("author_id")
  content    String
  isInternal Boolean        @default(false) @map("is_internal")
  createdAt  DateTime       @default(now()) @map("created_at")
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("service_request_comments")
}

model ServiceRequestHistory {
  id         String         @id @default(uuid())
  requestId  String         @map("request_id")
  oldStatus  String?        @map("old_status")
  newStatus  String         @map("new_status")
  changedBy  String         @map("changed_by")
  comment    String?
  createdAt  DateTime       @default(now()) @map("created_at")
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [changedBy], references: [id], onDelete: Cascade)

  @@map("service_request_histories")
}

model LostFoundItem {
  id           String           @id @default(uuid())
  type         String // LOST, FOUND
  reportedById String           @map("reported_by")
  title        String
  description  String
  category     String           @default("OTHER") // ID_DOCUMENT, ELECTRONICS, BOOK, CLOTHING, ACCESSORY, OTHER
  locationId   String?          @map("location_id")
  locationText String?          @map("location_text")
  itemDate     DateTime         @default(now()) @map("item_date")
  image        String?
  status       String           @default("OPEN") // OPEN, CLAIMED, RESOLVED, CLOSED
  isModerated  Boolean          @default(true) @map("is_moderated")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  reportedBy   User             @relation(fields: [reportedById], references: [id], onDelete: Cascade)
  location     CampusPlace?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  claims       LostFoundClaim[]

  @@map("lost_found_items")
}

model LostFoundClaim {
  id            String        @id @default(uuid())
  itemId        String        @map("item_id")
  claimantId    String        @map("claimant_id")
  description   String
  contactInfo   String?       @map("contact_info")
  status        String        @default("PENDING") // PENDING, APPROVED, REJECTED
  moderatedById String?       @map("moderated_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  item          LostFoundItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimant      User          @relation("ClaimantLostFound", fields: [claimantId], references: [id], onDelete: Cascade)
  moderator     User?         @relation("ModeratedClaims", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@map("lost_found_claims")
}

model EmergencyContact {
  id           String       @id @default(uuid())
  name         String
  category     String       @default("SECURITY") // SECURITY, MEDICAL, FIRE, DISASTER, HELPLINE, ADMIN
  phone        String
  altPhone     String?      @map("alt_phone")
  email        String?
  locationId   String?      @map("location_id")
  locationText String?      @map("location_text")
  instructions String?
  priority     Int          @default(1)
  isDemo       Boolean      @default(true) @map("is_demo")
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  location     CampusPlace? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@map("emergency_contacts")
}

model Feedback {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type") // SERVICE, EVENT, FACILITY, GENERAL, HELPDESK
  targetId   String?  @map("target_id")
  rating     Int
  comment    String
  status     String   @default("PUBLISHED") // PENDING, PUBLISHED, ARCHIVED
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model Notification {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  type          String // NOTICE, EVENT, SERVICE_REQUEST, LOST_FOUND, SYSTEM
  title         String
  message       String
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  isRead        Boolean   @default(false) @map("is_read")
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ==========================================
// PHASE 5: CAMPUS INTELLIGENCE + GEMINI
// ==========================================

model Conversation {
  id        String                @id @default(uuid())
  userId    String                @map("user_id")
  title     String                @default("New Conversation")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]

  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  role           String       // USER, ASSISTANT, SYSTEM
  content        String
  sources        Json?
  actions        Json?
  toolsUsed      Json?        @map("tools_used")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

model KnowledgeDocument {
  id          String           @id @default(uuid())
  title       String
  slug        String           @unique
  category    String           @default("GENERAL") // ACADEMIC_POLICY, EXAM_RULES, ADMISSION, CAMPUS_LIFE, SAFETY, FACILITY_GUIDELINES, GENERAL
  summary     String
  content     String
  audience    String           @default("ALL") // ALL, STUDENT, FACULTY, ADMIN
  authorId    String?          @map("author_id")
  isPublished Boolean          @default(true) @map("is_published")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  chunks      KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String            @map("document_id")
  chunkIndex Int               @default(0) @map("chunk_index")
  title      String
  content    String
  keywords   String?
  createdAt  DateTime          @default(now()) @map("created_at")
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("knowledge_chunks")
}

model AIPendingAction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  actionType String   @map("action_type") // CREATE_SERVICE_REQUEST, REGISTER_EVENT, JOIN_CLUB, SUBMIT_FEEDBACK
  targetData Json     @map("target_data")
  summary    String
  status     String   @default("PENDING") // PENDING, CONFIRMED, REJECTED, EXPIRED
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_pending_actions")
}

model AIAuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  role         String   @default("STUDENT")
  queryIntent  String?  @map("query_intent")
  model        String   @default("gemini-2.5-flash")
  toolsUsed    Json?    @map("tools_used")
  sourcesCited Json?    @map("sources_cited")
  latencyMs    Int      @default(0) @map("latency_ms")
  status       String   @default("SUCCESS") // SUCCESS, ERROR, RATE_LIMITED, SAFETY_BLOCKED, FALLBACK
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("ai_audit_logs")
}

